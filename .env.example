# =============================================================================
# Cloud Agent - Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# LLM Configuration (DashScope / Alibaba Cloud)
DASHSCOPE_API_KEY=sk-your-api-key-here
MODEL=qwen-plus
# BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Weather API (optional)
# OPENWEATHER_API_KEY=your-key

# Redis (short-term memory)
REDIS_URL=redis://localhost:6379
REDIS_TTL=1800

# Milvus (long-term memory + semantic cache)
MILVUS_HOST=localhost
MILVUS_PORT=19530
# MILVUS_API_KEY=your-milvus-token

# Neo4j (knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# MySQL (mock cloud platform data)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=cloud_platform

# Embedding
EMBEDDING_DIM=1536

# Logging
LOG_LEVEL=INFO